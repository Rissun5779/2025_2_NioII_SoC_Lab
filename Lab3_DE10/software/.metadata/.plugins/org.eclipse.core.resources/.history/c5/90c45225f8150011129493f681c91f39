#include <unistd.h>
#include <stdint.h>
#include "system.h"
#include <io.h>
// Memory Map
#define LED_REG (*(volatile uint32_t*)PIO_LED_BASE)
// variable
#define MS 1000
#define Lab3
// main
int main()
{
  unsigned char j     = 0x01;
  int32_t       count = 0;
  int32_t       led   = 0;

#ifdef defined(Lab2)
  while(1){
    if(j == 0x01){
       j = 0x80;
       LED_REG = j;
    }else{
       j >>= 1;
       LED_REG = j;
    }

    usleep(30*MS);
  }
#elif definedLab3)
  while(1){
    for(count = 0, led = 0x01;count<8;count++, led=(led<<1)){
       LED_REG = led;
       usleep(500*MS);
    }
  }
#endif
  return 0;
}
